<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Application Windows (MAUI Blazor Hybrid) : le constructeur visuel de scripts.
       Toute l'interface et la logique sont dans StreamDeck.ScriptBuilder ; ce projet n'est que l'hôte. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>StreamDeck.ScriptBuilderApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>Stream Deck Script Builder</ApplicationTitle>
    <ApplicationId>com.streamdeck.scriptbuilder</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- Application « classique » : un .exe à lancer directement, sans installation MSIX -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B0D12" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <!-- Enregistrement vocal de trigger depuis le PC (v1.34.18, WindowsSpeechRecognizer) : moteur de dictée de Windows. -->
    <PackageReference Include="System.Speech" Version="8.*" />
    <ProjectReference Include="..\StreamDeck.ScriptBuilder\StreamDeck.ScriptBuilder.csproj" />
  </ItemGroup>

</Project>

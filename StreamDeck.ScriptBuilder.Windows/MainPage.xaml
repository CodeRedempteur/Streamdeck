<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:builder="clr-namespace:StreamDeck.ScriptBuilder.Components;assembly=StreamDeck.ScriptBuilder"
             x:Class="StreamDeck.ScriptBuilderApp.MainPage"
             BackgroundColor="#0B0D12">

    <BlazorWebView HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type builder:App}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>

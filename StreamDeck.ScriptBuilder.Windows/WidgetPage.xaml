<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:builder="clr-namespace:StreamDeck.ScriptBuilder.Components;assembly=StreamDeck.ScriptBuilder"
             x:Class="StreamDeck.ScriptBuilderApp.WidgetPage"
             BackgroundColor="#0B0D12">

    <BlazorWebView HostPage="wwwroot/widget.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type builder:Widget}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>

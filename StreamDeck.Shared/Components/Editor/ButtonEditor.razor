    // ----- Type -----

    private void SetKind(string value)
    {
        if (!int.TryParse(value, out var number) || !Enum.IsDefined((ButtonKind)number)) return;

        var kind = (ButtonKind)number;
        Button.Kind = kind;
        _sizeError = null;

        switch (kind)
        {
            case ButtonKind.Wake when Button.Icon == DefaultIcon:
                Button.Icon = "fa-solid fa-power-off";
                break;

            case ButtonKind.Sequence when Button.Icon == DefaultIcon:
                Button.Icon = "fa-solid fa-list-check";
                break;

            case ButtonKind.Picker when Button.Icon == DefaultIcon:
                Button.Icon = "fa-solid fa-list-ul";
                break;

            case ButtonKind.VolumeSlider:
                if (Button.Icon == DefaultIcon) Button.Icon = "fa-solid fa-volume-high";
                TrySetSpan(3, 1);
                break;

            case ButtonKind.MediaControls:
                if (Button.Icon == DefaultIcon) Button.Icon = "fa-solid fa-music";
                TrySetSpan(3, 1);
                break;

            case ButtonKind.InfoDisplay when Button.Icon == DefaultIcon:
                Button.Icon = "fa-solid fa-expand";
                break;

            case ButtonKind.FindPhone when Button.Icon == DefaultIcon:
                Button.Icon = "fa-solid fa-phone-volume";
                break;

            case ButtonKind.Timer when Button.Icon == DefaultIcon:
                Button.Icon = "fa-solid fa-stopwatch";
                break;
        }

        State.Notify();
    }


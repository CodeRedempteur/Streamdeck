    // ----- Position -----

    private void Move(int delta)
    {
        var buttons = Page.Buttons;
        var i = buttons.IndexOf(Button);
        var j = i + delta;
        if (i < 0 || j < 0 || j >= buttons.Count) return;

        (buttons[i], buttons[j]) = (buttons[j], buttons[i]);
        State.Notify();
    }

    private bool _moveWorkspaceOpen;

    private IReadOnlyList<ChoiceItem> WorkspaceChoices =>
        State.Cfg.Workspaces.Where(w => w.Id != State.Ws.Id)
            .Select(w => new ChoiceItem(w.Id.ToString(), w.Name, $"{w.Pages.Count} page{(w.Pages.Count > 1 ? "s" : "")}", w.Icon))
            .ToList();

    private void MoveToWorkspace(string id)
    {
        _moveWorkspaceOpen = false;
        if (!Guid.TryParse(id, out var workspaceId)) return;

        var target = State.Cfg.Workspaces.FirstOrDefault(w => w.Id == workspaceId);
        if (target is null || target == State.Ws) return;

        Page.Buttons.Remove(Button);

        // Première page où le bouton tient ; sinon une nouvelle page, comme quand une page se remplit trop.
        var destPage = target.Pages.FirstOrDefault(p => p.CanFit(Button.ColSpan, Button.RowSpan));
        if (destPage is null)
        {
            destPage = target.Pages.Count > 0 ? target.Pages[^1].NewPageLikeThis() : new DeckPage();
            target.Pages.Add(destPage);
        }

        // La grille de la page de destination peut être plus petite : on adapte la taille du bouton si besoin.
        Button.ColSpan = Math.Clamp(Button.ColSpan, 1, destPage.Columns);
        Button.RowSpan = Math.Clamp(Button.RowSpan, 1, destPage.Rows);
        destPage.Buttons.Add(Button);

        State.Notify();
    }

    private bool CannotMoveToPage(int delta)
    {
        var target = State.PageIndex + delta;
        return target < 0 || target >= State.PageCount || !State.Ws.Pages[target].CanFit(Button.ColSpan, Button.RowSpan);
    }

    private void MoveToPage(int delta)
    {
        if (CannotMoveToPage(delta)) return;

        var target = State.Ws.Pages[State.PageIndex + delta];
        Page.Buttons.Remove(Button);

        // Vers la page précédente : en dernier ; vers la suivante : en premier.
        if (delta < 0) target.Buttons.Add(Button);
        else target.Buttons.Insert(0, Button);

        State.Notify();
    }

    private void Remove()
    {
        Page.Buttons.Remove(Button);
        State.Notify();
    }

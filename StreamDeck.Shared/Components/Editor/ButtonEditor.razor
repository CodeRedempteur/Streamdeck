    // ----- Taille -----

    private void SetColSpan(int value) => TrySetSpan(value, Button.RowSpan);
    private void SetRowSpan(int value) => TrySetSpan(Button.ColSpan, value);

    /// <summary>Change la taille seulement s'il reste assez de place sur la page.</summary>
    private void TrySetSpan(int columns, int rows)
    {
        columns = Math.Clamp(columns, 1, Page.Columns);
        rows = Math.Clamp(rows, 1, Page.Rows);

        if (Page.CanFit(columns, rows, Button))
        {
            Button.ColSpan = columns;
            Button.RowSpan = rows;
            _sizeError = null;
        }
        else
        {
            _sizeError = "Pas assez de place sur cette page pour cette taille.";
        }
    }


    private async Task OnImageFileSelected(InputFileChangeEventArgs e)
    {
        _imageError = null;
        var file = e.File;
        if (file is null) return;

        if (file.Size > MaxImageBytes)
        {
            _imageError = $"Image trop lourde ({file.Size / 1024} Ko, {MaxImageBytes / 1024} Ko maximum) : réduis-la ou utilise un lien.";
            State.Notify();
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxImageBytes + 1);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
            Button.ImageUrl = $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        catch (Exception ex)
        {
            _imageError = $"Impossible de lire cette image : {ex.Message}";
        }

        State.Notify();
    }

    /// <summary>v1.34.19 : équivalent de <see cref="OnImageFileSelected"/> mais via le sélecteur natif (écran noir/plantage avec &lt;InputFile&gt; sur cet hôte — voir INativeImagePicker).</summary>
    private async Task PickNativeImageAsync()
    {
        _imageError = null;
        var dataUrl = await NativeImagePicker.PickImageAsync();
        if (dataUrl is null) { State.Notify(); return; } // annulé, ou échec silencieux — même traitement qu'un InputFile annulé

        if (!TryCheckImageSize(dataUrl, MaxImageBytes, out var error))
        {
            _imageError = error;
            State.Notify();
            return;
        }

        Button.ImageUrl = dataUrl;
        State.Notify();
    }

    /// <summary>Vérifie la taille (décodée) d'une image déjà en data URI — le sélecteur natif, contrairement à InputFile, ne donne la taille qu'après lecture complète du fichier.</summary>
    private static bool TryCheckImageSize(string dataUrl, long maxBytes, out string? error)
    {
        var comma = dataUrl.IndexOf(',');
        var base64 = comma >= 0 ? dataUrl[(comma + 1)..] : dataUrl;
        var approxBytes = (long)base64.Length * 3 / 4;

        if (approxBytes > maxBytes)
        {
            error = $"Image trop lourde (~{approxBytes / 1024} Ko, {maxBytes / 1024} Ko maximum) : réduis-la ou utilise un lien.";
            return false;
        }

        error = null;
        return true;
    }


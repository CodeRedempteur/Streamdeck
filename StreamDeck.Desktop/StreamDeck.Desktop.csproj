<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StreamDeck.Desktop</RootNamespace>
    <!-- Nom de l'exécutable attendu par install.sh -->
    <AssemblyName>StreamDeck</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PhotinoX.Blazor" Version="5.2.0" />
    <ProjectReference Include="..\StreamDeck.Shared\StreamDeck.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- install.sh est copié à la racine du dossier publié -->
    <None Update="install.sh" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Le wwwroot partagé (CSS, Font Awesome) est copié à côté de l'exécutable, à côté de index.html. -->
  <ItemGroup>
    <SharedWebRoot Include="..\StreamDeck.Shared\wwwroot\**\*" />
  </ItemGroup>

  <Target Name="CopySharedWebRootToOutput" AfterTargets="Build">
    <Copy SourceFiles="@(SharedWebRoot)"
          DestinationFiles="@(SharedWebRoot->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopySharedWebRootToPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(SharedWebRoot)"
          DestinationFiles="@(SharedWebRoot->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>

    private string? _notice;
    private bool _noticeOk;

    // ----- Raccourcis globaux -----

    private void AddHotkey()
    {
        Config.Update(c => c.Hotkeys.Add(new HotkeyBinding()));
    }

    private void RemoveHotkey(HotkeyBinding h) => Config.Update(c => c.Hotkeys.RemoveAll(x => x.Id == h.Id));

    private void SetHotkeyEnabled(HotkeyBinding h, bool value) => Config.Update(c => c.Hotkeys.First(x => x.Id == h.Id).Enabled = value);

    private void SetHotkeyAction(HotkeyBinding h, string value)
    {
        if (!Enum.TryParse<HotkeyAction>(value, out var action)) return;
        Config.Update(c => c.Hotkeys.First(x => x.Id == h.Id).Action = action);
    }

    private void SetHotkeyScript(HotkeyBinding h, string value) => Config.Update(c => c.Hotkeys.First(x => x.Id == h.Id).ScriptName = value);

    private void SetHotkeyKeys(HotkeyBinding h, string value)
    {
        Config.Update(c => c.Hotkeys.First(x => x.Id == h.Id).Keys = value);
        _notice = $"Raccourci « {value} » enregistré.";
        _noticeOk = true;
    }

    // ----- Raccourcis rapides (éditeur) -----

    private void AddQuickAdd() => Config.Update(c => c.QuickAddShortcuts.Add(new QuickAddBinding()));

    private void RemoveQuickAdd(QuickAddBinding q) => Config.Update(c => c.QuickAddShortcuts.RemoveAll(x => x.Id == q.Id));

    private void SetQuickAddEnabled(QuickAddBinding q, bool value) => Config.Update(c => c.QuickAddShortcuts.First(x => x.Id == q.Id).Enabled = value);

    private void SetQuickAddKind(QuickAddBinding q, string value)
    {
        if (!Enum.TryParse<StepKind>(value, out var kind)) return;
        Config.Update(c => c.QuickAddShortcuts.First(x => x.Id == q.Id).Kind = kind);
    }

    private void SetQuickAddKeys(QuickAddBinding q, string value) => Config.Update(c => c.QuickAddShortcuts.First(x => x.Id == q.Id).Keys = value);

    // ----- Widget de bureau (apparence) -----

    private void SetWidgetVariant(string value) => Config.Update(c => c.WidgetVariant = value);

    private void SetWidgetFont(string value) => Config.Update(c => c.WidgetFont = value);

    private string? _fontError;

    private async Task PickWidgetFont()
    {
        _fontError = null;
        try
        {
            var path = await Picker.PickFileAsync(new[] { ".ttf", ".otf", ".woff", ".woff2" });
            if (string.IsNullOrWhiteSpace(path)) return;
            if (!File.Exists(path)) { _fontError = "Fichier introuvable."; return; }

            Config.Update(c => c.WidgetCustomFontPath = new Uri(path).AbsoluteUri);
        }
        catch (Exception ex)
        {
            _fontError = $"Impossible de référencer cette police : {ex.Message}";
        }
    }

    private void SetWidgetRoundedCorners(bool value) => WidgetHost.SetRoundedCorners(value);

    private void SetWidgetAlwaysOnTop(bool value) => WidgetHost.SetAlwaysOnTop(value);

    private void SetWidgetCustomBackground(string? value) => Config.Update(c => c.WidgetCustomBackground = string.IsNullOrWhiteSpace(value) ? "#12141B" : value);

    private void SetWidgetCustomForeground(string? value) => Config.Update(c => c.WidgetCustomForeground = string.IsNullOrWhiteSpace(value) ? "#E7E9EE" : value);

    private void SetWidgetSize(string value) => Config.Update(c => c.WidgetSizePreset = value);

    private void SetWidgetFreeResize(bool value) => WidgetHost.SetFreeResize(value);

    // ----- Boîtes mail -----

    private readonly HashSet<string> _expandedMailAccounts = new();

    private void ToggleMailAccountExpanded(MailAccount account)
    {
        if (!_expandedMailAccounts.Remove(account.Id)) _expandedMailAccounts.Add(account.Id);
    }

    private void AddMailAccount()
    {
        var account = new MailAccount();
        _expandedMailAccounts.Add(account.Id);
        Config.Update(c => c.MailAccounts.Add(account));
    }

    private void RemoveMailAccount(MailAccount account) => Config.Update(c => c.MailAccounts.RemoveAll(x => x.Id == account.Id));

    private void SetMailSmtpPort(MailAccount account, string? value)
    {
        if (int.TryParse(value, out var port) && port > 0) SetMailField(account, a => a.SmtpPort = port);
    }

    /// <summary>Choisit le logo de la signature (v1.34.5) — même convention qu'une image de touche épinglée : le
    /// chemin choisi est mémorisé en <c>file://…</c> (voir <see cref="PinImageResolver"/> pour la raison).</summary>
    private async Task PickSignatureLogo(MailAccount account)
    {
        var path = await Picker.PickFileAsync(new[] { ".png", ".jpg", ".jpeg", ".gif", ".webp" });
        if (string.IsNullOrWhiteSpace(path)) return;
        SetMailField(account, a => a.SignatureLogoUrl = new Uri(path).AbsoluteUri);
    }

    private void SetMailField(MailAccount account, Action<MailAccount> apply) =>
        Config.Update(c => { var a = c.MailAccounts.FirstOrDefault(x => x.Id == account.Id); if (a is not null) apply(a); });

    private void SetMailPort(MailAccount account, string? value)
    {
        if (int.TryParse(value, out var port) && port > 0) SetMailField(account, a => a.ImapPort = port);
    }

    private void SetMailPassword(MailAccount account, string? value)
    {
        if (string.IsNullOrEmpty(value)) return;
        SetMailField(account, a => a.ProtectedPassword = MailCredentialProtector.Protect(value));
    }

    private void SetMailRefreshMinutes(string? value)
    {
        if (int.TryParse(value, out var minutes) && minutes > 0) Config.Update(c => c.WidgetMailRefreshMinutes = minutes);
    }

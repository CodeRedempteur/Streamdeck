        Config.Update(c =>
        {
            var p = c.WidgetPins.FirstOrDefault(x => x.Id == pin.Id);
            if (p is null) return;
            p.Icon = string.IsNullOrWhiteSpace(v.Icon) ? "fa-solid fa-bolt" : v.Icon;
            p.Color = string.IsNullOrWhiteSpace(v.Color) ? "#3b82f6" : v.Color;
        });

        _editingPin = Config.Current.WidgetPins.FirstOrDefault(x => x.Id == pin.Id);
    }


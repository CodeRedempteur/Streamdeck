    private string? _recordingPinId;

    private async Task RecordPinTrigger(WidgetPin pin)
    {
        if (!Speech.Available || _recordingPinId is not null) return;

        _recordingPinId = pin.Id;
        StateHasChanged();

        try
        {
            var text = await Speech.RecognizeOnceAsync();
            if (!string.IsNullOrWhiteSpace(text))
            {
                var current = Config.Current.WidgetPins.FirstOrDefault(x => x.Id == pin.Id);
                var triggers = current is null ? new List<string>() : new List<string>(current.VoiceTriggers);
                if (!triggers.Any(t => t.Equals(text, StringComparison.OrdinalIgnoreCase))) triggers.Add(text.Trim());
                Config.Update(c => { var p = c.WidgetPins.FirstOrDefault(x => x.Id == pin.Id); if (p is not null) p.VoiceTriggers = triggers; });
            }
        }
        finally
        {
            _recordingPinId = null;
        }
    }


    private ChoiceOption? _editingOption;

    private void OpenOptionAppearance(ChoiceOption option) => _editingOption = option;

    private void ApplyOptionAppearance((string Icon, string Color) v)
    {
        var option = _editingOption;
        if (option is null) return;

        Config.Update(c =>
        {
            foreach (var pin in c.WidgetPins)
            {
                var o = pin.Options.FirstOrDefault(x => x.Id == option.Id);
                if (o is null) continue;
                o.Icon = string.IsNullOrWhiteSpace(v.Icon) ? "fa-solid fa-bolt" : v.Icon;
                o.Color = string.IsNullOrWhiteSpace(v.Color) ? "#3b82f6" : v.Color;
                break;
            }
        });

        _editingOption = Config.Current.WidgetPins.SelectMany(p => p.Options).FirstOrDefault(x => x.Id == option.Id);
    }


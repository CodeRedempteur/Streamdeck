    // ----- Touches d'un bloc "pins" (v1.34.1) : plus de catalogue global séparé — chaque bloc crée/modifie/retire les siennes. -----

    /// <summary>Touches de ce bloc précis, dans l'ordre choisi — une touche retirée ailleurs (ne devrait plus arriver) disparaît simplement.</summary>
    private List<WidgetPin> PinsInBlock(WidgetPageBlock block) =>
        block.PinIds
            .Select(id => Config.Current.WidgetPins.FirstOrDefault(p => p.Id == id))
            .Where(p => p is not null)
            .Select(p => p!)
            .ToList();

    private void AddPinToBlock(WidgetWorkspace workspace, WidgetPageEntry page, WidgetPageBlock block)
    {
        var pin = new WidgetPin();
        Config.Update(c =>
        {
            c.WidgetPins.Add(pin);
            var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id);
            var p = w?.Pages.FirstOrDefault(x => x.Id == page.Id);
            var b = p?.Blocks.FirstOrDefault(x => x.Id == block.Id);
            b?.PinIds.Add(pin.Id);
        });
    }

    private void RemovePinFromBlock(WidgetWorkspace workspace, WidgetPageEntry page, WidgetPageBlock block, WidgetPin pin) =>
        Config.Update(c =>
        {
            var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id);
            var p = w?.Pages.FirstOrDefault(x => x.Id == page.Id);
            var b = p?.Blocks.FirstOrDefault(x => x.Id == block.Id);
            b?.PinIds.Remove(pin.Id);
            c.WidgetPins.RemoveAll(x => x.Id == pin.Id);
        });

    private void SetPinScript(WidgetPin pin, string value) => Config.Update(c => { var p = c.WidgetPins.FirstOrDefault(x => x.Id == pin.Id); if (p is not null) p.ScriptName = value; });

    private string? _pinImageError;
    private string? _pinImageErrorFor;

    private void SetPinImage(WidgetPin pin, string? value)
    {
        _pinImageError = null;
        Config.Update(c => { var p = c.WidgetPins.FirstOrDefault(x => x.Id == pin.Id); if (p is not null) p.ImageUrl = value ?? ""; });
    }

    private void SetPinImageOnly(WidgetPin pin, bool value) =>
        Config.Update(c => { var p = c.WidgetPins.FirstOrDefault(x => x.Id == pin.Id); if (p is not null) p.ImageOnly = value; });

    private async Task PickPinImage(WidgetPin pin)
    {
        _pinImageError = null;
        _pinImageErrorFor = pin.Id;

        try
        {
            var path = await Picker.PickFileAsync(new[] { ".png", ".jpg", ".jpeg", ".gif", ".bmp", ".webp" });
            if (string.IsNullOrWhiteSpace(path)) return;

            if (!File.Exists(path)) { _pinImageError = "Fichier introuvable."; return; }

            SetPinImage(pin, new Uri(path).AbsoluteUri);
        }
        catch (Exception ex)
        {
            _pinImageError = $"Impossible de référencer cette image : {ex.Message}";
        }
    }

    private WidgetPin? _editingPin;

    private void OpenPinAppearance(WidgetPin pin) => _editingPin = pin;

    private void ApplyPinAppearance((string Icon, string Color) v)
    {
        var pin = _editingPin;

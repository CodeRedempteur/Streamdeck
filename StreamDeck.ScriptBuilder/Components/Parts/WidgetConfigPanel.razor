@code {
    private static readonly IReadOnlyList<ChoiceItem> PinColumnsChoices =
        Enumerable.Range(2, 5).Select(n => new ChoiceItem(n.ToString(), n.ToString(), null, "fa-solid fa-grip")).ToList();

    private IReadOnlyList<ChoiceItem> ScriptChoices =>
        Store.HasServerFolder
            ? Store.List().Select(s => new ChoiceItem(s.Id, s.Id, s.Folder.Length > 0 ? s.Folder : null, "fa-solid fa-scroll")).ToList()
            : Array.Empty<ChoiceItem>();

    private IReadOnlyList<ChoiceItem> MailAccountChoices =>
        new List<ChoiceItem> { new("", "Toutes les boîtes", null, "fa-solid fa-inbox") }
            .Concat(Config.Current.MailAccounts.Select(a => new ChoiceItem(a.Id, string.IsNullOrWhiteSpace(a.DisplayName) ? a.Username : a.DisplayName, null, "fa-solid fa-envelope")))
            .ToList();

    /// <summary>v1.34.8 : les listes de la bibliothèque (onglet « Tâches », TodoLists.razor) — un bloc "todo" en choisit une, comme un bloc "mail" choisit une boîte.</summary>
    /// <summary>v1.37.2, demandé explicitement ("parametré affiché tache du jour, dun jour particulié, lendemain,
    /// hier, jour en avant") : quel jour un bloc "calendar" affiche — voir <see cref="WidgetPageBlock.CalendarDayMode"/>.</summary>
    private static readonly IReadOnlyList<ChoiceItem> CalendarDayModeChoices = new List<ChoiceItem>
    {
        new("today", "Aujourd'hui", null, "fa-solid fa-calendar-day"),
        new("offset", "Décalage (hier/demain/dans X jours)", null, "fa-solid fa-calendar-plus"),
        new("specific", "Jour précis", null, "fa-solid fa-calendar-check")
    };

    private IReadOnlyList<ChoiceItem> TodoListChoices =>
        new List<ChoiceItem> { new("", "Aucune liste choisie", null, "fa-solid fa-list-check") }
            .Concat(Config.Current.TodoLists.Select(l => new ChoiceItem(l.Id, string.IsNullOrWhiteSpace(l.Name) ? "(sans nom)" : l.Name, l.Folder.Length > 0 ? l.Folder : null, "fa-solid fa-list-check")))
            .ToList();

    // ----- Page de veille (v1.34.5), réglage global — voir Widget.razor pour la logique de bascule. -----

    private void SetIdleEnabled(bool value) => Config.Update(c => c.WidgetIdleEnabled = value);

    private void SetIdleDelay(string value)
    {
        if (int.TryParse(value, out var n) && n > 0) Config.Update(c => c.WidgetIdleDelaySeconds = n);
    }

    private void SetIdleTransition(string value)
    {
        if (int.TryParse(value, out var n) && n >= 0) Config.Update(c => c.WidgetIdleTransitionMs = n);
    }

    private void SetIdleRotateSeconds(string value)
    {
        if (int.TryParse(value, out var n) && n > 0) Config.Update(c => c.WidgetIdleRotateSeconds = n);
    }

    // ----- Onglet affiché dans la config du widget (v1.35) : "pages" (composition habituelle) ou "phone" (modèles
    // téléphone, voir PhoneTemplatesPanel.razor), demandé explicitement ("un onglet... dans la config du Widget"). -----
    private string _widgetTab = "pages";

    // ----- Espaces de travail / pages (v1.34.0 : sélection en grille de cartes, comme la bibliothèque de scripts) -----

    /// <summary>Espace affiché (ses pages) — un id plutôt qu'une référence directe : reste valide après un Config.Update, qui remplace toujours Config.Current par une copie.</summary>
    private string? _selectedWorkspaceId;

    private WidgetWorkspace? SelectedWorkspace =>
        Config.Current.WidgetWorkspaces.FirstOrDefault(w => w.Id == _selectedWorkspaceId)
        ?? Config.Current.WidgetWorkspaces.FirstOrDefault();

    /// <summary>Page ouverte dans la fenêtre « Modifier » (id, même raison que ci-dessus) — null = fenêtre fermée.</summary>
    private string? _editingPageId;

    private WidgetPageEntry? EditingPage => SelectedWorkspace?.Pages.FirstOrDefault(p => p.Id == _editingPageId);

    private void OpenPageEditor(WidgetPageEntry page) => _editingPageId = page.Id;

    private static string DefaultPageName(int index) => $"Page {index + 1}";

    private static string TypeLabel(string type) => type switch
    {
        "clock" => "Horloge",
        "server" => "Contrôles serveur",
        "mail" => "Courrier",
        "pins" => "Touches",
        "weather" => "Météo",
        "worldclock" => "Heure dans le monde",
        "todo" => "Liste de tâches",
        "calendar" => "Calendrier",
        _ => "?"
    };

    private static string BlockIcon(string type) => type switch
    {
        "clock" => "fa-solid fa-clock",
        "server" => "fa-solid fa-power-off",
        "mail" => "fa-solid fa-envelope",
        "pins" => "fa-solid fa-grip",
        "weather" => "fa-solid fa-cloud-sun",
        "worldclock" => "fa-solid fa-earth-americas",
        "todo" => "fa-solid fa-list-check",
        "calendar" => "fa-solid fa-calendar-days",
        _ => "fa-solid fa-question"
    };

    private string MailBlockTitle(WidgetPageBlock block)
    {
        if (string.IsNullOrEmpty(block.MailAccountId)) return "Courrier (toutes les boîtes)";
        var acc = Config.Current.MailAccounts.FirstOrDefault(a => a.Id == block.MailAccountId);
        return acc is null ? "Courrier (toutes les boîtes)" : $"Courrier ({(string.IsNullOrWhiteSpace(acc.DisplayName) ? acc.Username : acc.DisplayName)})";
    }

    private string BlockTitle(WidgetPageBlock block) => block.Type switch
    {
        "mail" => MailBlockTitle(block),
        "weather" => string.IsNullOrWhiteSpace(block.WeatherLocationName) ? "Météo (région à choisir)" : $"Météo ({block.WeatherLocationName})",
        "worldclock" => string.IsNullOrWhiteSpace(block.WorldClockLabel) ? "Heure dans le monde (à configurer)" : $"Heure dans le monde ({block.WorldClockLabel})",
        "todo" => TodoBlockTitle(block),
        _ => TypeLabel(block.Type)
    };

    /// <summary>
    /// v1.34.8 : le bloc ne fait plus que choisir une liste de la bibliothèque (voir <see cref="TodoListChoices"/>) —
    /// les tâches elles-mêmes vivent dans TodoLists.razor (onglet « Tâches »), plus dans le bloc.
    /// </summary>
    private string TodoBlockTitle(WidgetPageBlock block)
    {
        var list = Config.Current.TodoLists.FirstOrDefault(l => l.Id == block.TodoListId);
        if (list is null) return "Liste de tâches (à choisir)";
        return list.Items.Count == 0 ? $"{list.Name} (vide)" : $"{list.Name} ({list.Items.Count(t => !t.Done)}/{list.Items.Count})";
    }

    /// <summary>Résumé du contenu d'une page pour ses badges dans la grille (regroupe les blocs du même type : « Courrier ×2 »).</summary>
    private static IEnumerable<string> PageBlockSummaries(WidgetPageEntry page) =>
        page.Blocks.GroupBy(b => b.Type).Select(g => g.Count() > 1 ? $"{TypeLabel(g.Key)} ×{g.Count()}" : TypeLabel(g.Key));

    private void AddWorkspace()
    {
        var ws = new WidgetWorkspace { Name = $"Espace {Config.Current.WidgetWorkspaces.Count + 1}" };
        Config.Update(c => c.WidgetWorkspaces.Add(ws));
        _selectedWorkspaceId = ws.Id;
    }

    private void RemoveWorkspace(WidgetWorkspace workspace)
    {
        Config.Update(c =>
        {
            if (c.WidgetWorkspaces.Count <= 1) return; // toujours au moins un espace
            c.WidgetWorkspaces.RemoveAll(w => w.Id == workspace.Id);
            // v1.34.11 : plus besoin de gérer ici le report de "l'espace affiché" — le filet de sécurité générique
            // dans BuilderConfigService.Update (ActiveWidgetWorkspaceId pointant toujours vers un espace existant)
            // s'en charge pour toute suppression.
        });
        if (_selectedWorkspaceId == workspace.Id) _selectedWorkspaceId = null;
    }

    private void RenameWorkspace(WidgetWorkspace workspace, string name) =>
        Config.Update(c => { var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id); if (w is not null) w.Name = string.IsNullOrWhiteSpace(name) ? "Espace" : name; });

    /// <summary>v1.34.12 : choix MULTIPLE — plusieurs espaces peuvent être actifs à la fois (voir WidgetWorkspace.Active).
    /// Le filet de sécurité générique dans BuilderConfigService.Update garantit qu'au moins un le reste toujours, et
    /// que l'espace AFFICHÉ (ActiveWidgetWorkspaceId, choisi séparément via le sélecteur du widget) en fait partie.</summary>
    private void SetWorkspaceActive(WidgetWorkspace workspace, bool value) =>
        Config.Update(c => { var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id); if (w is not null) w.Active = value; });

    private void AddWorkspacePage(WidgetWorkspace workspace) =>
        Config.Update(c => { var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id); w?.Pages.Add(new WidgetPageEntry()); });

    /// <summary>Participation d'une page à la veille (v1.34.6) — voir WidgetPageEntry.ShowInIdle/IdleOnly.</summary>
    private void SetPageIdleFlags(WidgetWorkspace workspace, WidgetPageEntry page, bool showInIdle, bool idleOnly) =>
        Config.Update(c =>
        {
            var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id);
            var p = w?.Pages.FirstOrDefault(x => x.Id == page.Id);
            if (p is null) return;
            p.ShowInIdle = showInIdle;
            p.IdleOnly = showInIdle && idleOnly; // "uniquement en veille" n'a pas de sens si la page n'est même pas en veille
        });

    private void RenamePage(WidgetWorkspace workspace, WidgetPageEntry page, string name) =>
        Config.Update(c =>
        {
            var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id);
            var p = w?.Pages.FirstOrDefault(x => x.Id == page.Id);
            if (p is not null) p.Name = name.Trim();
        });

    private void RemoveWorkspacePage(WidgetWorkspace workspace, WidgetPageEntry page)
    {
        // Les touches de chaque bloc "pins" de cette page n'appartiennent qu'à elle (v1.34.1) : les retirer du
        // catalogue global avec la page, plutôt que de les laisser orphelines.
        var pinIds = page.Blocks.Where(b => b.Type == "pins").SelectMany(b => b.PinIds).ToList();
        Config.Update(c =>
        {
            var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id);
            w?.Pages.RemoveAll(p => p.Id == page.Id);
            if (pinIds.Count > 0) c.WidgetPins.RemoveAll(p => pinIds.Contains(p.Id));
        });
        if (_editingPageId == page.Id) _editingPageId = null;
    }

    private void MoveWorkspacePage(WidgetWorkspace workspace, int index, int delta)
    {
        Config.Update(c =>
        {
            var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id);
            if (w is null) return;
            var newIndex = index + delta;
            if (newIndex < 0 || newIndex >= w.Pages.Count) return;
            (w.Pages[index], w.Pages[newIndex]) = (w.Pages[newIndex], w.Pages[index]);
        });
    }

    // ----- Glisser-déposer des pages (v1.34.3) : réordonner dans le même espace, ou déposer sur un autre espace (sa
    // puce, en haut) pour l'y déplacer — même mécanisme que les scripts/dossiers de la bibliothèque (sdbDragCard.js,
    // la carte suit le curseur), pas de nouveau système. Les flèches Monter/Descendre restent en secours (renommées
    // Avant/Après, la grille de pages n'étant pas verticale) pour rester utilisable sans souris précise/tactile. -----

    private string? _draggingPageId;
    private string? _draggingPageWorkspaceId;
    private int? _dragOverPageIndex;
    private string? _dragOverWorkspaceId;

    private bool IsDraggingPage => _draggingPageId is not null;

    private static string PageElementId(string pageId) => "widget-page-" + pageId.Replace(" ", "_");

    private string PageCardClass(WidgetPageEntry page, int index)
    {
        var css = "lib-card";
        if (_draggingPageId == page.Id) css += " is-dragging";
        else if (IsDraggingPage && _dragOverPageIndex == index) css += " is-dragover";
        return css;
    }

    private string WorkspaceChipClass(WidgetWorkspace ws)
    {
        var css = SelectedWorkspace?.Id == ws.Id ? "lib-workspace is-on" : "lib-workspace";
        if (_dragOverWorkspaceId == ws.Id) css += " is-dragover";
        return css;
    }

    private async Task OnDragStartPage(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, WidgetWorkspace workspace, WidgetPageEntry page)
    {
        _draggingPageId = page.Id;
        _draggingPageWorkspaceId = workspace.Id;
        _dragOverPageIndex = null;
        _dragOverWorkspaceId = null;
        await JS.InvokeVoidAsync("sdbDragCard.start", PageElementId(page.Id), e.ClientX, e.ClientY);
    }

    private void HoverPageIndex(int index)
    {
        if (IsDraggingPage) _dragOverPageIndex = index;
    }

    private void UnhoverPageIndex()
    {
        if (IsDraggingPage) _dragOverPageIndex = null;
    }

    private void HoverWorkspaceForDrop(string workspaceId)
    {
        if (IsDraggingPage && workspaceId != _draggingPageWorkspaceId) _dragOverWorkspaceId = workspaceId;
    }

    private void UnhoverWorkspaceForDrop() => _dragOverWorkspaceId = null;

    /// <summary>Relâché n'importe où sans passer par une zone de dépose valide : annule proprement.</summary>
    private async Task CancelPageDrag()
    {
        var elId = _draggingPageId is not null ? PageElementId(_draggingPageId) : null;
        _draggingPageId = null;
        _draggingPageWorkspaceId = null;
        _dragOverPageIndex = null;
        _dragOverWorkspaceId = null;
        await JS.InvokeVoidAsync("sdbDragCard.stop", elId);
    }

    private async Task DropOnPageIndex(WidgetWorkspace workspace, int targetIndex)
    {
        if (_draggingPageId is null || _draggingPageWorkspaceId != workspace.Id) { await CancelPageDrag(); return; }

        var draggedId = _draggingPageId;
        var elId = PageElementId(draggedId);
        _draggingPageId = null;
        _draggingPageWorkspaceId = null;
        _dragOverPageIndex = null;
        _dragOverWorkspaceId = null;
        await JS.InvokeVoidAsync("sdbDragCard.stop", elId);

        Config.Update(c =>
        {
            var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id);
            if (w is null) return;
            var fromIndex = w.Pages.FindIndex(p => p.Id == draggedId);
            if (fromIndex < 0) return;
            var page = w.Pages[fromIndex];
            w.Pages.RemoveAt(fromIndex);
            // La position visée venait de la liste AVANT retrait : si l'élément tenu était avant elle, tout ce qui
            // suit vient de décaler d'un cran une fois retiré — même ajustement que DropAtIndex dans Library.razor.
            var insertAt = fromIndex < targetIndex ? targetIndex - 1 : targetIndex;
            insertAt = Math.Clamp(insertAt, 0, w.Pages.Count);
            w.Pages.Insert(insertAt, page);
        });
    }

    private async Task DropPageOnWorkspace(WidgetWorkspace targetWorkspace)
    {
        if (_draggingPageId is null || _draggingPageWorkspaceId is null || _draggingPageWorkspaceId == targetWorkspace.Id)
        {
            await CancelPageDrag();
            return;
        }

        var draggedId = _draggingPageId;
        var sourceWorkspaceId = _draggingPageWorkspaceId;
        var elId = PageElementId(draggedId);
        _draggingPageId = null;
        _draggingPageWorkspaceId = null;
        _dragOverPageIndex = null;
        _dragOverWorkspaceId = null;
        await JS.InvokeVoidAsync("sdbDragCard.stop", elId);

        Config.Update(c =>
        {
            var source = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == sourceWorkspaceId);
            var target = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == targetWorkspace.Id);
            if (source is null || target is null) return;
            var idx = source.Pages.FindIndex(p => p.Id == draggedId);
            if (idx < 0) return;
            var page = source.Pages[idx];
            source.Pages.RemoveAt(idx);
            target.Pages.Add(page);
        });

        // Suit la page vers son nouvel espace plutôt que de rester affiché sur celui qui vient de la perdre.
        _selectedWorkspaceId = targetWorkspace.Id;
    }

    // ----- Blocs d'une page (v1.34.0) : toujours ajoutables, même type déjà présent ou non — voir WidgetPageBlock. -----

    private void AddPageBlock(WidgetWorkspace workspace, WidgetPageEntry page, string type) =>
        Config.Update(c =>
        {
            var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id);
            var p = w?.Pages.FirstOrDefault(x => x.Id == page.Id);
            p?.Blocks.Add(new WidgetPageBlock { Type = type });
        });

    private void RemovePageBlock(WidgetWorkspace workspace, WidgetPageEntry page, WidgetPageBlock block)
    {
        // Un bloc "pins" retiré emporte ses propres touches (v1.34.1 : plus de catalogue global partagé).
        var pinIds = block.Type == "pins" ? new List<string>(block.PinIds) : new List<string>();
        Config.Update(c =>
        {
            var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id);
            var p = w?.Pages.FirstOrDefault(x => x.Id == page.Id);
            p?.Blocks.RemoveAll(b => b.Id == block.Id);
            if (pinIds.Count > 0) c.WidgetPins.RemoveAll(x => pinIds.Contains(x.Id));
        });
    }

    private void MoveBlock(WidgetWorkspace workspace, WidgetPageEntry page, int index, int delta) =>
        Config.Update(c =>
        {
            var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id);
            var p = w?.Pages.FirstOrDefault(x => x.Id == page.Id);
            if (p is null) return;
            var newIndex = index + delta;
            if (newIndex < 0 || newIndex >= p.Blocks.Count) return;
            (p.Blocks[index], p.Blocks[newIndex]) = (p.Blocks[newIndex], p.Blocks[index]);
        });

    private void SetBlockField(WidgetWorkspace workspace, WidgetPageEntry page, WidgetPageBlock block, Action<WidgetPageBlock> apply) =>
        Config.Update(c =>
        {
            var w = c.WidgetWorkspaces.FirstOrDefault(x => x.Id == workspace.Id);
            var p = w?.Pages.FirstOrDefault(x => x.Id == page.Id);
            var b = p?.Blocks.FirstOrDefault(x => x.Id == block.Id);
            if (b is not null) apply(b);
        });

    private void SetBlockMailAccount(WidgetWorkspace workspace, WidgetPageEntry page, WidgetPageBlock block, string accountId) =>
        SetBlockField(workspace, page, block, b => b.MailAccountId = string.IsNullOrEmpty(accountId) ? null : accountId);

    private void SetBlockPinColumns(WidgetWorkspace workspace, WidgetPageEntry page, WidgetPageBlock block, string value)
    {
        if (int.TryParse(value, out var n)) SetBlockField(workspace, page, block, b => b.PinColumns = n);
    }


    // ----- Bloc "weather" (v1.34.5) : recherche de région via Open-Meteo (WeatherService), résultats affichés sous
    // le champ de recherche — pas de ChoiceField ici, la liste vient d'un appel réseau à chaque frappe, pas d'un
    // catalogue fixe. -----

    private readonly Dictionary<string, string> _weatherQuery = new();
    private readonly Dictionary<string, List<WeatherLocationResult>> _weatherResults = new();

    private string GetWeatherQuery(WidgetPageBlock block) => _weatherQuery.TryGetValue(block.Id, out var q) ? q : block.WeatherLocationName;

    private async Task OnWeatherQueryChanged(WidgetPageBlock block, string value)
    {
        _weatherQuery[block.Id] = value;
        _weatherResults[block.Id] = value.Trim().Length >= 2 ? await Weather.SearchLocationsAsync(value) : new();
    }

    private void PickWeatherLocation(WidgetWorkspace workspace, WidgetPageEntry page, WidgetPageBlock block, WeatherLocationResult loc)
    {
        SetBlockField(workspace, page, block, b =>
        {
            b.WeatherLocationName = loc.DisplayName;
            b.WeatherLat = loc.Latitude;
            b.WeatherLon = loc.Longitude;
        });
        _weatherQuery[block.Id] = loc.DisplayName;
        _weatherResults[block.Id] = new();
    }


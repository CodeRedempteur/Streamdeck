    private static readonly IReadOnlyList<ChoiceItem> PhoneActionChoices = new List<ChoiceItem>
    {
        new(nameof(PhoneAction.FindPhone), "Sonnerie / alarme", "Fait sonner et vibrer le téléphone (comme « Retrouver mon téléphone »)", "fa-solid fa-bell"),
        new(nameof(PhoneAction.OpenApp), "Ouvrir une application", "Lance une application sur le téléphone par son paquet Android", "fa-solid fa-mobile-screen-button")
    };


        if (Enum.TryParse<CloseTarget>(v, out var t)) Step.CloseTarget = t;
        return Changed();
    }
    private Task SetLaunchSpotify(bool v) { Step.LaunchSpotify = v; return Changed(); }
    private Task SetBrowser(string v) { Step.Browser = v; return Changed(); }
    private Task SetMediaKey(string v) { Step.MediaKey = v; return Changed(); }

    private Task SetTarget(string v)

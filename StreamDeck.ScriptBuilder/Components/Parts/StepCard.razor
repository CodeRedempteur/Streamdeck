    // ----- Téléphone ciblé (v1.34.21, "plusieurs téléphone") -----
    private IReadOnlyList<ChoiceItem> PhoneTargetChoices => Config.Current.PhoneTargets
        .Select(p => new ChoiceItem(p.Id.ToString(), p.Name, null, "fa-solid fa-mobile-screen-button"))
        .ToList();

    /// <summary>Si l'étape ne désigne aucun téléphone (null) ou vise un téléphone supprimé depuis, affiche le défaut.</summary>
    private string PhoneTargetValue =>
        (Step.PhoneId is { } id && Config.Current.PhoneTargets.Any(p => p.Id == id) ? id : Config.Current.DefaultPhoneId)?.ToString() ?? "";

    private Task SetPhoneTarget(string v)
    {
        Step.PhoneId = Guid.TryParse(v, out var id) ? id : null;
        return Changed();
    }

    // ----- Macro -----

    private bool _recording;
    private TimeSpan _elapsed;
    private CancellationTokenSource? _recordCts;

    private async Task StartRecording()
    {
        if (!Recorder.CanRecord || _recording) return;

        _recording = true;
        _elapsed = TimeSpan.Zero;
        _recordCts = new CancellationTokenSource();
        var progress = new Progress<TimeSpan>(t =>
        {
            _elapsed = t;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            var result = await Recorder.RecordAsync(Step.MacroMaxDurationSeconds, Step.MacroStopKey, Step.MacroCaptureMouseMoves, progress, _recordCts.Token);
            Step.MacroActions = result.Actions.ToList();
        }
        finally
        {
            _recording = false;
            _recordCts.Dispose();
            _recordCts = null;
        }

        await Changed();
    }

    private void CancelRecording() => _recordCts?.Cancel();

    private Task ClearMacro()
    {
        Step.MacroActions.Clear();
        return Changed();
    }

    private Task SetMacroStopKey(string v)
    {
        if (Enum.TryParse<MacroControlKey>(v, out var k)) Step.MacroStopKey = k;
        return Changed();
    }

    private Task SetMacroAbortKey(string v)
    {
        if (Enum.TryParse<MacroControlKey>(v, out var k)) Step.MacroAbortKey = k;
        return Changed();
    }

    private Task SetMacroCaptureMouseMoves(bool v)
    {
        Step.MacroCaptureMouseMoves = v;
        return Changed();
    }

    private Task SetMacroStopOnManualMove(bool v)
    {
        Step.MacroStopOnManualMove = v;
        return Changed();
    }

    private static string FormatElapsed(TimeSpan t) => t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"mm\:ss");
